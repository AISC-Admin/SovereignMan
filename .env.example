# Copy this file to .env.local for local testing with `vercel dev`.
# In production, set these same two variables in your Vercel project:
# Settings → Environment Variables (never commit real values to git).

# Comma-separated list of valid access codes to unlock /recherche.html.
# Any one of these codes will work — you can hand a different one to each teammate.
SEARCH_TOOL_PASSWORDS=809231,809232,809233,809234,809235,809236,809237,809238,809239

# Your OSINT Industries API key.
# Generate it at: https://app.osint.industries → Account settings → API keys
# (requires an Intermediate or Advanced subscription).
OSINT_INDUSTRIES_API_KEY=your-osint-industries-api-key

# --- Optional: "Company / entity" search type (/api/entity-search.js) ---
# Three of its sources are free/open and need NO key at all (French company registry
# via data.gouv.fr, GLEIF, ICIJ Offshore Leaks). Two more are optional add-ons:
PAPPERS_API_KEY=your-pappers-api-key

# Zefix (Switzerland's official federal commercial register). Genuinely free —
# create a self-service account at https://www.zefix.admin.ch (no paid contract)
# to get these two values, used as HTTP Basic Auth credentials.
ZEFIX_USERNAME=your-zefix-username
ZEFIX_PASSWORD=your-zefix-password

# --- Optional: monthly per-access-code search quota + email alert (api/_quota.js) ---
# Tracks searches across ALL types (/api/search, /api/entity-search, /api/face-search)
# per access code, and emails a one-time warning per code per month once it crosses
# 200/300 (or ~334/500 for the two higher-limit codes below).
# Storage — free Upstash Redis database (https://upstash.com, or via Vercel Marketplace):
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Email — free Resend account (https://resend.com):
RESEND_API_KEY=your-resend-api-key
QUOTA_ALERT_FROM=SovereignMan Search <alerts@sovereignman.dev>
QUOTA_ALERT_TO=contact@sovereignman.dev

# --- Optional: facial recognition accessory (/api/face-search.js) ---
# Off by default. Read the legal warning in api/face-search.js and SETUP-RECHERCHE.md
# before setting FACE_SEARCH_ENABLED=true. Requires your own self-hosted CompreFace
# server (https://github.com/exadel-inc/CompreFace) — not something Vercel can host.
FACE_SEARCH_ENABLED=false
COMPREFACE_URL=https://your-compreface-server.example.com
COMPREFACE_API_KEY=your-compreface-instance-key
